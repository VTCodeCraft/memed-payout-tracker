# Copy to .env (git-ignored) for `docker compose`. These are placeholders, never real secrets.

# Needed by the api service when the whole stack runs (`docker compose up --build`), not by
# mongo and redis alone. At least 32 random characters; the API refuses this placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace-with-at-least-32-random-characters>

# Host ports, all bound to 127.0.0.1 (defaults shown).
# WEB_PORT=3200
# API_PORT=4200
# MONGO_PORT=27018
# REDIS_PORT=6379
