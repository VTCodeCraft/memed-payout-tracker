# Copy to apps/frontend/.env.local for local development. Never commit real env files.

# Origin of the Express API, e.g. https://your-api.onrender.com
# apiUrl() appends /api/<endpoint>; a trailing slash or /api suffix here is tolerated.
# Inlined into the client bundle at build time: rebuild/redeploy after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000
