# Copy to apps/server/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas SRV connection string (use the memed_dev database locally).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/memed_dev?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace-with-at-least-32-random-characters>
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

BCRYPT_ROUNDS=10
