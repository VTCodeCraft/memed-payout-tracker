# Copy to apps/server/.env for local development. Never commit the real .env.

# development | test | production (default: development)
NODE_ENV=development
PORT=4000

# Required. MongoDB Atlas SRV connection string for the memed_app database user.
# Must name a database (/memed_dev locally, /memed_prod on Render); URL-encode
# special characters in the password.
MONGODB_URI=mongodb+srv://memed_app:<db-password>@<cluster-host>/memed_dev?retryWrites=true&w=majority

# Required. At least 32 random characters; the server refuses this placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace-with-at-least-32-random-characters>
# Access token lifetime: <number><s|m|h|d>, e.g. 7d or 12h (default: 7d).
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS (scheme://host[:port], no path).
# Required in production; defaults to localhost:3000 and :3001 in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
